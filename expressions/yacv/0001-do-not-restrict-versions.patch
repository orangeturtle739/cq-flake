From cf9beb8c3c92f296f2d827f49d6d21df81bfe767 Mon Sep 17 00:00:00 2001
From: Jacob Glueck <swimgiraffe435@gmail.com>
Date: Fri, 6 Mar 2026 07:24:29 -0800
Subject: [PATCH] do not restrict versions

---
 pyproject.toml | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 95fd6b2..81eaa76 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,5 +1,5 @@
 [build-system]
-requires = ["poetry-core==2.1.3", "taskipy==1.14.1"]
+requires = ["poetry-core"]
 build-backend = "poetry.core.masonry.api"
 
 [tool.poetry]
@@ -23,12 +23,12 @@ build_backend = "poetry build --format wheel"
 python = ">=3.12,<3.13" # Due to vtk transitive dependency of build123d -> cadquery-ocp -> vtk
 
 # CAD
-build123d = ">=0.9,<0.10"
+build123d = ">=0.9"
 
 # Misc
 pygltflib = "^1.16.2"
-pillow = ">=10.2,<12.0"
-poetry-core = "==2.2.1"
+pillow = ">=10.2"
+poetry-core = ">2"
 
 [tool.poetry.group.dev.dependencies]
-taskipy = "^1.14.1"
+taskipy = ">1"
-- 
