Date: Fri, 6 Mar 2026 06:41:10 -0800
Subject: [PATCH] do not restrict ocp version

---
 pyproject.toml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 6705c82..71c4caa 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -33,7 +33,7 @@ classifiers = [
 ]
 
 dependencies = [
-    "cadquery-ocp-novtk >= 7.9, < 8.0",
+    "ocp",
     "typing_extensions >= 4.6.0, < 5",
     "numpy >= 2, < 3",
     "svgpathtools >= 1.5.1, < 2",
@@ -45,7 +45,7 @@ dependencies = [
     "trianglesolver",
     "sympy",
     "scipy",
-    "webcolors ~= 24.8.0",
+    "webcolors",
 
     # Install standard official lib3mf on everything EXCEPT linux aarch64
     "lib3mf >= 2.4.1; sys_platform != 'linux' or platform_machine != 'aarch64'",
